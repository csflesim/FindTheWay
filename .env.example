# Supabase — copy to .env.local and fill in values from your Supabase project
# Settings → API in the Supabase dashboard

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only — never prefix with NEXT_PUBLIC_. Used for admin actions (e.g. CMS).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 敏感設定加密金鑰 — LINE secret / SMTP 密碼落地前用 AES-256-GCM 加密
# 產生方式：openssl rand -base64 32（本機與 Vercel 必須用同一把）
SETTINGS_ENCRYPTION_KEY=YOUR-32-BYTE-BASE64-KEY
